# URL publique utilisée par les canonical, le sitemap et les contrôles d'origine.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr

# Envoi des demandes via FormSubmit vers la boîte KORIX.
CONTACT_TO_EMAIL=korixagency@gmail.com
CONTACT_DELIVERY_MODE=formsubmit

# Alternative lorsque KORIX possédera un domaine vérifié avec Resend.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL=KORIX <site@votre-domaine.fr>

# Analytics optionnel, chargé uniquement après consentement et sans session replay.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Coordonnées publiques confirmées uniquement. Les champs vides ne sont pas affichés.
NEXT_PUBLIC_CONTACT_EMAIL=korixagency@gmail.com
NEXT_PUBLIC_PHONE=+33 7 59 35 40 91

# Données légales confirmées. Compléter l'adresse et l'immatriculation après la création de l'activité.
NEXT_PUBLIC_LEGAL_NAME=Itiel Apetse
NEXT_PUBLIC_LEGAL_FORM=Activité en cours de création
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=Itiel Apetse
NEXT_PUBLIC_HOST_NAME=
NEXT_PUBLIC_HOST_ADDRESS=
